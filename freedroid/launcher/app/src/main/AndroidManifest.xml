<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeDroid Launcher manifest.

  NOT YET BUILT OR INSTALLED. Unverified.

  PERMISSION POLICY
  =================
  The launcher is not a privileged component and must not become one. Every
  permission it holds is a permission an attacker inherits if the launcher is
  ever compromised, so the list below is argued rather than assumed.
  See docs/security/SECURITY_MODEL.md section T2.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      NO PERMISSIONS ARE REQUESTED AT ALL.

      An earlier draft declared QUERY_ALL_PACKAGES. Android Lint flags that as an
      error, and it was right: the <queries> declaration below already makes
      every activity with a LAUNCHER category visible, which is exactly and only
      what a launcher needs to fill its drawer. QUERY_ALL_PACKAGES was both
      redundant and broader, so it is gone.

      NOT YET VERIFIED ON A DEVICE. If the drawer comes up empty on first device
      run, package visibility is the first thing to check - but the fix is to
      justify a narrower <queries> entry, not to reinstate a blanket permission.
    -->

    <!--
      Package visibility. Makes launchable activities visible to
      LauncherApps.getActivityList() without any permission at all.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!--
      DELIBERATELY NOT REQUESTED
      ==========================
        INSTALL_PACKAGES          privileged; no FreeDroid app holds it
        REQUEST_INSTALL_PACKAGES  the launcher installs nothing
        SYSTEM_ALERT_WINDOW       no overlays; a launcher does not need to draw
                                  over other apps and it is a phishing primitive
        READ_EXTERNAL_STORAGE     wallpaper is composited by the system via
                                  windowShowWallpaper, so the bitmap is never read
        MANAGE_EXTERNAL_STORAGE   no filesystem access of any kind
        INTERNET                  the launcher has no network need; omitting it
                                  means a compromised launcher cannot exfiltrate
        BIND_APPWIDGET            widgets are Phase 4 and will be re-argued then
        EXPAND_STATUS_BAR         not required for this version
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeDroidLauncher">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density">

            <!-- Makes the activity eligible to become the default HOME app.
                 The user chooses; the launcher cannot make itself default. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Marks this as a launcher for the system's own purposes. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
        </activity>
    </application>
</manifest>
