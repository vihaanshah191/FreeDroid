<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher stores nothing worth transferring and nothing a user would want
  restored onto another device: its state is derived from whatever is installed
  there. Both cloud backup and device-to-device transfer are therefore excluded
  wholesale rather than curated, which is also the smaller attack surface.

  Paired with android:allowBackup="false". allowBackup alone is deprecated from
  Android 12; this file is the supported replacement.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
